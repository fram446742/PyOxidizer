# Build configuration generated by `pyoxidizer python`.
#
# Defines a single executable embedding a Python interpreter and its standard
# library, accepting the same command line arguments as CPython's `python`.
#
# This file is written to a temporary directory during the build and is not
# meant to be kept. Run `pyoxidizer init config` instead if you want a
# configuration file to edit - add third-party packages, change interpreter
# behavior, or control which modules are embedded.

# Intermediate build artifacts. `pyoxidizer python` points this at a temporary
# directory; it defaults to one under the current directory otherwise.
BUILD_PATH = VARS.get("BUILD_PATH", CWD + "/build")

set_build_path(BUILD_PATH)


def make_exe():
    dist = default_python_distribution(flavor = "{{flavor}}"{{#if python_version}}, python_version = "{{python_version}}"{{/if}})

    policy = dist.make_python_packaging_policy()

    # Embed every extension module the distribution provides, so functionality
    # like ssl, sqlite3, lzma and ctypes works out of the box.
    policy.extension_module_filter = "all"

    # Embed the standard library's module sources and package resources in
    # addition to bytecode. Source is what lets the interpreter recompile
    # modules when invoked with -O or -OO.
    policy.include_distribution_sources = True
    policy.include_distribution_resources = True

    # Load everything from memory. The produced executable is the only file
    # that needs to be distributed.
    policy.resources_location = "in-memory"

    # Emit bytecode for every optimization level. Without the -O1 and -O2
    # variants, imports performed during interpreter startup fail when the
    # executable is invoked with -O or -OO.
    policy.bytecode_optimize_level_zero = True
    policy.bytecode_optimize_level_one = True
    policy.bytecode_optimize_level_two = True

    python_config = dist.make_python_interpreter_config()

    # Behave like a `python` process: parse argv, honor PYTHON* environment
    # variables, and support -c, -m, script paths, stdin and --help.
    python_config.config_profile = "python"

    exe = dist.to_python_executable(
        name="{{program_name}}",
        packaging_policy=policy,
        config=python_config,
    )

    return exe

def make_install(exe):
    files = FileManifest()
    files.add_python_resource(".", exe)

    return files

register_target("exe", make_exe)
register_target("install", make_install, depends=["exe"], default=True)

resolve_targets()
